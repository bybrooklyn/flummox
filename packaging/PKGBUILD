# Maintainer: Brooklyn <brooklyn.halmstad@proton.me>
#
# Arch/CachyOS package. Build from a checkout with:
#   cd packaging && makepkg -si
#
# This recipe builds the working tree. The published flummox-bin AUR recipe
# is generated from verified release archives by distributions.py.

pkgname=flummox
pkgver=0.0.2
pkgrel=1
pkgdesc="Compress installed games with zstd on Linux, and keep playing them"
arch=('x86_64')
url="https://github.com/bybrooklyn/flummox"
license=('AGPL-3.0-or-later')
# The command-line tool needs nothing beyond libc: it talks to btrfs through
# ioctls rather than through btrfs-progs. The rest are what the GUI links
# against for its window, input and text.
depends=('glibc' 'gcc-libs' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcursor'
         'libxi' 'libxrandr' 'fontconfig')
makedepends=('cargo' 'git')
# FUSE runs Maximum Space mounts; either dialog helper enables folder browsing.
optdepends=('btrfs-progs: for inspecting compression'
            'fuse3: for Maximum Space mounts'
            'zenity: for native folder and report selection'
            'kdialog: for native folder and report selection on KDE')
options=('!lto')  # LTO is already configured in the release profile.

# Built straight from the checkout this file lives in, so there is no source
# array and nothing to checksum. `$startdir` is the packaging directory, so
# the repository root is one level up. A PKGBUILD for the AUR would instead
# fetch a tagged tarball and verify it. This one builds your own copy, where
# a checksum would change with every edit to the tree.
_tree="$startdir/.."

prepare() {
    cd "$_tree"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_tree"
    export RUSTUP_TOOLCHAIN=stable
    cargo build --frozen --release --features gui,pack-mount
}

check() {
    cd "$_tree"
    export RUSTUP_TOOLCHAIN=stable
    # The btrfs tests check the filesystem they are running on and skip
    # themselves elsewhere, so this passes on any build host.
    cargo test --frozen --all-features
}

package() {
    cd "$_tree"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm755 "target/release/$pkgname-gui" "$pkgdir/usr/bin/$pkgname-gui"
    install -Dm644 "packaging/$pkgname.desktop" \
        "$pkgdir/usr/share/applications/$pkgname.desktop"
    # A user unit, not a system one: it compresses one person's game library
    # and needs no privileges beyond that person's own.
    install -Dm644 "packaging/$pkgname-watch.service" \
        "$pkgdir/usr/lib/systemd/user/$pkgname-watch.service"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 docs/usage.md "$pkgdir/usr/share/doc/$pkgname/usage.md"
    install -Dm644 docs/status.md "$pkgdir/usr/share/doc/$pkgname/status.md"
    install -Dm644 docs/install.md "$pkgdir/usr/share/doc/$pkgname/install.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
